# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env — ele contém segredos.

# ===== NEXTAUTH & DATABASE =====
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# PostgreSQL (Neon, Supabase, etc.)
# Em serverless (Neon), inclua connect_timeout alto — o banco suspende quando ocioso
# e o padrão do Prisma (5s) é curto demais para acordá-lo, causando erros P1001.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=10"

# ===== GOOGLE OAUTH =====
# console.cloud.google.com -> APIs & Services -> Credentials
# Callback: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== GITHUB OAUTH =====
# github.com/settings/developers -> OAuth Apps
# Callback: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ===== STRIPE =====
# dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=
# ID do preço recorrente (mensal) do seu plano
STRIPE_PRICE_ID=
# Local: gerado por `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Produção: gerado ao criar o endpoint no dashboard do Stripe
STRIPE_WEBHOOK_SECRET=

# ===== EMAIL (BREVO SMTP) =====
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ATENÇÃO: precisa ser um remetente VERIFICADO no Brevo,
# senão os emails são descartados silenciosamente.
SMTP_FROM=

# ===== RATE LIMITING (opcional, mas recomendado em produção) =====
# Sem estas variáveis o rate limiting fica DESATIVADO (login/cadastro sem
# proteção contra força bruta). Crie um Redis grátis em console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
